{
  "expo": {
    "name": "AnimateMemories",
    "slug": "AnimateMemories",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "animatememories",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hexerve.AnimateMemories",
      "buildNumber": "1",
      "userInterfaceStyle": "light",
      "infoPlist": {
        "NSCameraUsageDescription": "AnimateMemories uses the camera to let you take photos to animate and restore.",
        "NSPhotoLibraryUsageDescription": "AnimateMemories needs access to your photo library to select photos for animation and restoration.",
        "NSPhotoLibraryAddUsageDescription": "AnimateMemories needs permission to save your restored photos and animated videos to your photo library.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIStatusBarStyle": "UIStatusBarStyleDarkContent",
        "UIViewControllerBasedStatusBarAppearance": true
      },
      "appleTeamId": "N6M4Z5254R"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.hexerve.AnimateMemories",
      "versionCode": 3,
      "userInterfaceStyle": "light",
      "statusBar": {
        "barStyle": "dark-content",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-av",
      "react-native-iap"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
